# ============================================================
# Morphix — Environment Variable Template
# Copy this file to .env and fill in your real values.
# This file is safe to commit — it contains NO real secrets.
# ============================================================

# --- AI / LLM Provider (add at least one) ---
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Database (optional — app works without it) ---
# DATABASE_URL=mysql://user:password@localhost:3306/morphix

# --- Auth & Security ---
# Use a long random string in production. On Render this is auto-generated.
JWT_SECRET=change-this-to-a-long-random-string-in-production

# --- OAuth (optional — leave blank for local dev) ---
OAUTH_SERVER_URL=

# --- App ID ---
VITE_APP_ID=morphix-local

# --- Server Port ---
# On Render this is set automatically. Don't change it there.
PORT=3000

# --- CORS (production only) ---
# Set this on Render to your Vercel frontend URL, e.g. https://morphix.vercel.app
# FRONTEND_URL=https://your-morphix-app.vercel.app
